    {
      "kind": "button",
      "description": "Primary URL creation action, with hover, press, keyboard focus and pending states.",
      "refersTo": "button-primary",
      "html": "<button class=\"ds-primary\" type=\"button\">Shorten URL</button>",
      "css": ".ds-primary{font-family:'Source Sans 3','Segoe UI',system-ui,sans-serif;font-size:1rem;min-height:3.5rem;border:0;border-radius:.5rem;padding:.8rem 1.25rem;background:var(--color-plum,#4b365f);color:var(--color-surface,#fff);font-weight:650;cursor:pointer}.ds-primary:hover:not(:disabled){background:var(--color-plum-hover,#382547)}.ds-primary:active:not(:disabled){transform:translateY(1px)}.ds-primary:disabled{background:#766583;cursor:wait}.ds-primary:focus-visible{outline:3px solid var(--color-plum,#4b365f);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-primary:active:not(:disabled){transform:none}}",
      "name": "Primary Button"
    },
    {
      "kind": "input",
      "description": "Labeled destination field with URL entry hints.",
      "refersTo": "input",
      "html": "<label class=\"ds-label\" for=\"ds-url\">URL to shorten</label><input class=\"ds-input\" id=\"ds-url\" type=\"url\" placeholder=\"https://example.com/a-long-address\" />",
      "css": ".ds-input{font-family:'Source Sans 3','Segoe UI',system-ui,sans-serif;font-size:1rem;width:100%;min-width:0;min-height:3.5rem;border:1px solid #b6a6c5;border-radius:.5rem;padding:.8rem 1rem;background:var(--color-surface,#fff);color:var(--color-ink,#2e2536);caret-color:var(--color-plum,#4b365f)}.ds-input::placeholder{color:var(--color-muted,#66576f)}.ds-input:disabled{background:#e8e0ee}.ds-input[aria-invalid='true']{border-color:var(--color-error,#a12636)}.ds-input:focus-visible{outline:3px solid var(--color-plum,#4b365f);outline-offset:4px}.ds-label{font-family:'Source Sans 3','Segoe UI',system-ui,sans-serif;font-size:1rem;display:block;font-size:1rem;font-weight:650;margin-bottom:.5rem}",
      "name": "URL Field"
    },
    {
      "kind": "custom",
      "description": "Noninteractive plum brand band aligned with page content.",
      "refersTo": "brand-header",
      "html": "<header class=\"ds-brand\"><div class=\"ds-brand-width\">URL Shortener</div></header>",
      "css": ".ds-brand{font-family:'Source Sans 3','Segoe UI',system-ui,sans-serif;background:var(--color-plum,#4b365f);color:var(--color-surface,#fff);padding:1.3rem 0;font-size:1.65rem;font-weight:700;letter-spacing:-.02em}.ds-brand-width{width:min(70rem,calc(100% - 4rem));margin-inline:auto}@media(max-width:48rem){.ds-brand{font-size:1.35rem}.ds-brand-width{width:calc(100% - 2.5rem)}}",
      "name": "Brand Header"
    },
    {
      "kind": "custom",
      "description": "Amber service limitation notice with decorative outlined SVG.",
      "refersTo": "availability-notice",
      "html": "<aside class=\"ds-notice\" aria-label=\"Service availability\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6m0 3v.1\"/></svg><p>Links are saved, but redirects are not available yet.</p></aside>",
      "css": ".ds-notice{font-family:'Source Sans 3','Segoe UI',system-ui,sans-serif;display:flex;align-items:center;gap:1rem;padding:1.1rem 1.35rem;border-radius:.5rem;color:var(--color-warning-ink,#855200);background:var(--color-warning-bg,#fff0cc)}.ds-notice p{margin:0;line-height:1.5}.ds-notice svg{width:1.6rem;height:1.6rem;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round}",
      "name": "Availability Notice"
    },
    {

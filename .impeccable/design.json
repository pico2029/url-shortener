      "name": "Empty Result",
      "description": "Flat result region with honest empty-state instructions.",
      "html": "<section class=\"ds-result\" aria-labelledby=\"ds-result-title\"><h2 id=\"ds-result-title\">Your result</h2><p class=\"ds-empty\">Your short link will appear here.</p><p class=\"ds-help\">Enter a URL, then select Shorten URL.</p></section>"

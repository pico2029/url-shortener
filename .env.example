# Local development defaults only; replace before any external deployment.
PUBLIC_PORT=8080
# Optional override; otherwise Compose uses http://localhost:${PUBLIC_PORT}.
# SHORTENER_PUBLIC_BASE_URL=https://short.example.com
POSTGRES_DB=shortener
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener-local

# Optional Base64-encoded secret (at least 32 random bytes). If empty, sessions
# expire on backend restart. Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional redirect cache. Redis is not required for backend health or startup.
REDIRECT_CACHE_ENABLED=true
REDIRECT_CACHE_TTL=5m
REDIS_CONNECT_TIMEOUT=100ms
REDIS_TIMEOUT=100ms
